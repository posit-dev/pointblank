[0.285, "o", "\u001b[1;36mAvailable Pointblank Datasets                                                       \u001b[0m\r\n                                                                                    \r\n \u001b[1;35m \u001b[0m\u001b[1;35mDataset Name\u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;35mDimensions               \u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;35mDescription                          \u001b[0m\u001b[1;35m \u001b[0m \r\n \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \r\n \u001b[36m \u001b[0m\u001b[36msmall_table \u001b[0m\u001b[36m \u001b[0m \u001b[32m \u001b[0m\u001b[32m13 rows \u00d7 8 columns      \u001b[0m\u001b[32m \u001b[0m \u001b[37m \u001b[0m\u001b[37mSmall demo dataset for testing       \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mgame_revenue\u001b[0m\u001b[36m \u001b[0m \u001b[32m \u001b[0m\u001b[32m2,000 rows \u00d7 11 columns  \u001b[0m\u001b[32m \u001b[0m \u001b[37m \u001b[0m\u001b[37mGame development company revenue data\u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mnycflights  \u001b[0m\u001b[36m \u001b[0m \u001b[32m \u001b[0m\u001b[32m336,776 rows"]
[0.01, "o", " \u00d7 18 columns\u001b[0m\u001b[32m \u001b[0m \u001b[37m \u001b[0m\u001b[37mNYC airport flights data from 2013   \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mglobal_sales\u001b[0m\u001b[36m \u001b[0m \u001b[32m \u001b[0m\u001b[32m50,000 rows \u00d7 20 columns \u001b[0m\u001b[32m \u001b[0m \u001b[37m \u001b[0m\u001b[37mGlobal sales data across regions     \u001b[0m\u001b[37m \u001b[0m \r\n                                                                                    \r\n\r\n\u001b[2mUse these dataset names directly with any pb CLI command.\u001b[0m\r\n\u001b[2mExample: pb preview small_table\u001b[0m\r\n"]
