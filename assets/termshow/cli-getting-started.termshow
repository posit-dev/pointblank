[0.003, "o", "\r\u001b[2K\u001b[32m\u280b\u001b[0m \u001b[1;32mRunning 1 validation check(s)...\u001b[0m\r\n\u001b[?25h\r\u001b[1A\u001b[2K\r\n\u001b[1;36mValidation Result: Rows Distinct     \u001b[0m\r\n                                     \r\n \u001b[1;35m \u001b[0m\u001b[1;35mProperty         \u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;35mValue        \u001b[0m\u001b[1;35m \u001b[0m \r\n \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \r\n \u001b[36m \u001b[0m\u001b[36mData Source      \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37msmall_table  \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mCheck Type       \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37mrows-distinct\u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mTotal Rows Tested\u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37m13           \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mPassing Rows     \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37m11           \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mFailing Rows     \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37m2            \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mResult           \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[31m\u2717 FAILED\u001b[0m\u001b[37m     \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mDuplicate Rows   \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[31m2 found\u001b["]
