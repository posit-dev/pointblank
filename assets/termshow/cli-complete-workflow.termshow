[0.004, "o", "\r\u001b[2K\u001b[32m\u280b\u001b[0m \u001b[1;32mRunning 2 validation check(s)...\u001b[0m\r\n\u001b[?25h\r\u001b[1A\u001b[2K\r\n\r\n\u001b[1;36mValidation Result (1 of 2): Column Values  \u001b[0m\r\n\u001b[1;36mGreater Than Or Equal                      \u001b[0m\r\n                                           \r\n \u001b[1;35m \u001b[0m\u001b[1;35mProperty         \u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;35mValue              \u001b[0m\u001b[1;35m \u001b[0m \r\n \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \r\n \u001b[36m \u001b[0m\u001b[36mData Source      \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37mworldcities.csv    \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mCheck Type       \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37mcol-vals-ge        \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mColumn           \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37mlatitude           \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mComparison Value \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37m>= -90.0           \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mTotal Rows Tested\u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37m41,001             \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mPassing Rows     \u001b[0m\u001b[36m \u001b[0m \u001b[37"]
