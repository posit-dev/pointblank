[0.038, "o", "\u001b[32m\u2713\u001b[0m Loaded data source: Parquet file via `pb pl` \u001b[1m(\u001b[0m\u001b[35m/var/folders/s8/bj_jsx3d7jqd2btw7bwm6yx80000gp/T/\u001b[0m\u001b[95mpb_pipe_vk_ufzaq.parquet\u001b[0m\u001b[1m)\u001b[0m\r\n\u001b[32m\u280b\u001b[0m \u001b[1;32mLoading data...\u001b[0m"]
