[0.004, "o", "\r\n\u001b[1;36mValidation Result: Column Values Greater Than                                 \u001b[0m\r\n                                                                              \r\n \u001b[1;35m \u001b[0m\u001b[1;35mProperty         \u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;35mValue                                                 \u001b[0m\u001b[1;35m \u001b[0m \r\n \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \r\n \u001b[36m \u001b[0m\u001b[36mData Source      \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37mPolars expression (serialized to Parquet) from `pb pl`\u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mCheck Type       \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37mcol-vals-gt                                           \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mColumn           \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37mpop_millions                                          \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mComparison Value \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37m> 0.0   "]
[0.01, "o", "                                              \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mTotal Rows Tested\u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37m1,305                                                 \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mPassing Rows     \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37m1,305                                                 \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mFailing Rows     \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37m0                                                     \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mResult           \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[32m\u2713 PASSED\u001b[0m\u001b[37m                                              \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mValues Status    \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[32mAll values > 0.0\u001b[0m\u001b[37m                                      \u001b[0m\u001b[37m \u001b[0m \r\n                                                                              \r\n\r\n\u001b[32m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
