[0.009, "o", "\u001b[1;36mData Preview / Polars expression / polars                                  \u001b[0m\r\n\u001b[1;2;36m10 rows / 5 columns\u001b[0m\u001b[1;36m                                                        \u001b[0m\r\n                                                                           \r\n \u001b[1;35m        \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;35mcity_name  \u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;35mlatitude\u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;35mlongitude\u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;35mcountry     \u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;35mpopulation\u001b[0m\u001b[1;35m \u001b[0m \r\n \u001b[1;35m \u001b[0m\u001b[1;35m      \u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;2;33m<str>\u001b[0m\u001b[1;35m      \u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;2;33m<f64>\u001b[0m\u001b[1;35m   \u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;2;33m<f64>\u001b[0m\u001b[1;35m    \u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;2;33m<str>\u001b[0m\u001b[1;35m       \u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;2;33m<i64>\u001b[0m\u001b[1;35m     \u001b[0m\u001b[1;35m \u001b[0m \r\n \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[0.004, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \r\n \u001b[2m \u001b[0m\u001b[2m     \u001b[0m\u001b[2m1\u001b[0m\u001b[2m \u001b[0m \u001b[36m \u001b[0m\u001b[36mTokyo      \u001b[0m\u001b[36m \u001b[0m \u001b[36m \u001b[0m\u001b[36m35.6897 \u001b[0m\u001b[36m \u001b[0m \u001b[36m \u001b[0m\u001b[36m139.6922 \u001b[0m\u001b[36m \u001b[0m \u001b[36m \u001b[0m\u001b[36mJapan       \u001b[0m\u001b[36m \u001b[0m \u001b[36m \u001b[0m\u001b[36m37977000  \u001b[0m\u001b[36m \u001b[0m \r\n \u001b[2m \u001b[0m\u001b[2m     \u001b[0m\u001b[2m2\u001b[0m\u001b[2m \u001b[0m \u001b[36m \u001b[0m\u001b[36mJakarta    \u001b[0m\u001b[36m \u001b[0m \u001b[36m \u001b[0m\u001b[36m-6.2146 \u001b[0m\u001b[36m \u001b[0m \u001b[36m \u001b[0m\u001b[36m106.8451 \u001b[0m\u001b[36m \u001b[0m \u001b[36m \u001b[0m\u001b[36mIndonesia   \u001b[0m\u001b[36m \u001b[0m \u001b[36m \u001b[0m\u001b[36m34540000  \u001b[0m\u001b[36m \u001b[0m \r\n \u001b[2m \u001b[0m\u001b[2m     \u001b[0m\u001b[2m3\u001b[0m\u001b[2m \u001b[0m \u001b[36m \u001b[0m\u001b[36mDelhi      \u001b[0m\u001b[36m \u001b[0m \u001b[36m \u001b[0m\u001b[36m28.66   \u001b[0m\u001b[36m \u001b[0m \u001b[36m \u001b[0m\u001b[36m77.23    \u001b[0m\u001b[36m \u001b[0m \u001b[36m \u001b[0m\u001b[36mIndia       \u001b[0m\u001b[36m \u001b[0m \u001b[36m \u001b[0m\u001b[36m29617000  \u001b[0m\u001b[36m \u001b[0m \r\n \u001b[2m \u001b[0m\u001b[2m     \u001b[0m\u001b[2m4\u001b[0m\u001b[2m \u001b[0m \u001b[36m \u001b[0m\u001b[36mMumbai     \u001b[0m\u001b[36m \u001b[0m \u001b[36m \u001b[0m\u001b[36m18.9667 \u001b[0m\u001b[36m \u001b[0m \u001b[36m \u001b[0m\u001b[36m72.8333  \u001b[0m\u001b[36m \u001b[0m \u001b[36m \u001b[0m\u001b[36mIndia       \u001b[0m\u001b[36m \u001b[0m \u001b[36m \u001b[0m\u001b[36m23355000  \u001b[0m\u001b[3"]
