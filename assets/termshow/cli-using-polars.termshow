[0.004, "o", "\u001b[32m\u2713\u001b[0m rows-distinct validation completed\r\n\u001b[32m\u280b\u001b[0m \u001b[1;32mRunning 1 validation check(s)...\u001b[0m"]
[0.004, "o", "\r\u001b[2K\u001b[32m\u280b\u001b[0m \u001b[1;32mRunning 1 validation check(s)...\u001b[0m\r\n\u001b[?25h\r\u001b[1A\u001b[2K\r\n\u001b[1;36mValidation Result: Rows Distinct                                              \u001b[0m\r\n                                                                              \r\n \u001b[1;35m \u001b[0m\u001b[1;35mProperty         \u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;35mValue                                                 \u001b[0m\u001b[1;35m \u001b[0m \r\n \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \r\n \u001b[36m \u001b[0m\u001b[36mData Source      \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37mPolars expression (serialized to Parquet) from `pb pl`\u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mCheck Type       \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37mrows-distinct                                         \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mTotal Rows Tested\u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37m148                                                   \u001b[0m\u001b[37m "]
[0.004, "o", "\u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mPassing Rows     \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37m148                                                   \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mFailing Rows     \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[37m0                                                     \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mResult           \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[32m\u2713 PASSED\u001b[0m\u001b[37m                                              \u001b[0m\u001b[37m \u001b[0m \r\n \u001b[36m \u001b[0m\u001b[36mDuplicate Rows   \u001b[0m\u001b[36m \u001b[0m \u001b[37m \u001b[0m\u001b[32mNone found\u001b[0m\u001b[37m                                            \u001b[0m\u001b[37m \u001b[0m \r\n                                                                              \r\n\r\n\u001b[32m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m\r\n\u001b[32m\u2502\u001b[0m \u001b[32m\u2713 Validation PASSED: No duplic"]
