[0.043, "o", "\u001b[32m\u280b\u001b[0m \u001b[1;32mGenerating data scan...\u001b[0m\r\n\u001b[?25h\r\u001b[1A\u001b[2K"]
[0.004, "o", "\u001b[32m\u2713\u001b[0m Data scan completed in \u001b[1;36m0.\u001b[0m19s\r\nUse --output-html to save the full interactive scan report.\r\n\r\n\u001b[1;36mColumn Summary / Polars expression (serialized to Parquet) from `pb pl` / polars                                             \u001b[0m\r\n\u001b[1;2;36m9,756 rows / 3 columns\u001b[0m\u001b[1;36m                                                                                                       \u001b[0m\r\n                                                                                                                             \r\n \u001b[1;35m \u001b[0m\u001b[1;35mColumn            \u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;35mType    \u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;35m  NA\u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;35m    UQ\u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;35m   Mean\u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;35m     SD\u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;35m    Min\u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;35m    Med\u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;35m    Max\u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;35m   Q\u2081\u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m \u001b[0m\u001b[1;35m     Q\u2083\u001b[0m\u001b[1;35m \u001b[0m \u001b[1;35m"]
